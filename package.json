{
  "name": "pebble-calendar",
  "version": "0.4.0",
  "author": "kvnsr1",
  "private": true,
  "keywords": ["pebble-app"],
  "dependencies": {},
  "scripts": { "test": "node --test test/*.test.js" },
  "pebble": {
    "displayName": "PebbleCal",
    "uuid": "06c53645-3afd-4ebd-a7ab-bf80c5db422e",
    "projectType": "native",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": ["emery"],
    "watchapp": { "watchface": false },
    "usesPermissions": ["Calendar"],
    "messageKeys": {
      "TYPE": 0, "GENERATION": 1, "COUNT": 2, "UPDATED": 3,
      "INDEX": 4, "TITLE": 5, "LOCATION": 6, "CALENDAR": 7,
      "START": 8, "END": 9, "FLAGS": 10, "ERROR": 11,
      "DEMO": 12, "VERSION": 13, "TOKEN": 14,
      "ATTENDEES": 15, "ROOM_NAME": 16, "OFFICE": 17, "BUILDING": 18,
      "FLOOR": 19, "ROOM_NUMBER": 20, "CAPACITY": 21, "FACILITIES": 22,
      "ROOM_SOURCE": 23
    },
    "resources": { "media": [
      { "type": "bitmap", "name": "IMAGE_MENU_ICON", "file": "images/menu_icon.png", "menuIcon": true },
      { "type": "bitmap", "name": "ACTION_UP", "file": "images/pebble/up.png" },
      { "type": "bitmap", "name": "ACTION_DOWN", "file": "images/pebble/down.png" },
      { "type": "bitmap", "name": "ACTION_MORE", "file": "images/pebble/more.png" },
      { "type": "bitmap", "name": "ACTION_CHECK", "file": "images/pebble/check.png" }
    ] }
  }
}
