diff --git a/libpebble3/src/commonTest/kotlin/io/rebble/libpebblecommon/plugin/CalendarPluginAttendeesTest.kt b/libpebble3/src/commonTest/kotlin/io/rebble/libpebblecommon/plugin/CalendarPluginAttendeesTest.kt
new file mode 100644
index 0000000..d00001d
--- /dev/null
+++ b/libpebble3/src/commonTest/kotlin/io/rebble/libpebblecommon/plugin/CalendarPluginAttendeesTest.kt
@@ -0,0 +1,121 @@
+package io.rebble.libpebblecommon.plugin
+
+import io.rebble.libpebblecommon.calendar.CalendarEvent
+import io.rebble.libpebblecommon.calendar.EventAttendee
+import io.rebble.libpebblecommon.calendar.NewCalendarEvent
+import io.rebble.libpebblecommon.calendar.SystemCalendar
+import io.rebble.libpebblecommon.connection.endpointmanager.blobdb.TimeProvider
+import io.rebble.libpebblecommon.database.dao.CalendarDao
+import io.rebble.libpebblecommon.database.entity.CalendarEntity
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.flow.flowOf
+import kotlinx.coroutines.test.runTest
+import kotlinx.serialization.json.Json
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNull
+import kotlin.time.Duration.Companion.hours
+import kotlin.time.Instant
+
+private const val ROOM = "ABC | 1000 MB2-3rd-3.07 Example Room (8) [Team Room, Video]"
+
+private fun attendee(name: String?, email: String? = null) = EventAttendee(
+    name = name, email = email, role = null, attendanceStatus = null,
+)
+
+private class CalendarFixture : SystemCalendar, CalendarDao, TimeProvider {
+    var permitted = true
+    var reads = 0
+    var calendars = listOf(CalendarEntity(
+        platformId = "synthetic", name = "Test calendar", ownerName = "Test", ownerId = "test",
+        color = 0, enabled = true,
+    ))
+    var event = CalendarEvent(
+        id = "synthetic", calendarId = "synthetic", title = "Synthetic meeting", description = "",
+        location = null, startTime = now() + 1.hours, endTime = now() + 2.hours, allDay = false,
+        attendees = emptyList(), recurs = false, reminders = emptyList(),
+        availability = CalendarEvent.Availability.Busy, status = CalendarEvent.Status.Confirmed,
+        baseEventId = "synthetic",
+    )
+    val plugin = CalendarPlugin(this, this, this)
+
+    override fun now() = Instant.fromEpochSeconds(1_700_000_000)
+    override fun hasPermission() = permitted
+    override suspend fun getCalendars() = calendars
+    override suspend fun getCalendarEvents(calendar: CalendarEntity, startDate: Instant, endDate: Instant): List<CalendarEvent> {
+        reads++
+        return listOf(event)
+    }
+    override fun registerForCalendarChanges(): Flow<Unit>? = null
+    override suspend fun enableSyncForCalendar(calendar: CalendarEntity) = error("Unused")
+    override suspend fun createEvent(calendarId: String, event: NewCalendarEvent): String? = error("Unused")
+    override suspend fun defaultCalendarPlatformId(): String? = error("Unused")
+    override fun supportsPinActions() = false
+    override fun getFlow() = flowOf(calendars)
+    override suspend fun getAll() = calendars
+    override suspend fun insertOrReplace(calendar: CalendarEntity) = error("Unused")
+    override suspend fun update(calendar: CalendarEntity) = error("Unused")
+    override suspend fun delete(calendar: CalendarEntity) = error("Unused")
+    override suspend fun setEnabled(calendarId: Int, enabled: Boolean) = error("Unused")
+
+    suspend fun envelope(properties: List<String>? = listOf(CalendarPlugin.PROPERTY_ATTENDEES)) =
+        plugin.observe(CalendarPlugin.CATEGORY, CalendarPlugin.ITEM_EVENT, properties).first()
+}
+
+private fun SourceInstance.attendeeText(): String? =
+    properties[CalendarPlugin.PROPERTY_ATTENDEES]?.get(SourceShapeNames.LONG_TEXT)?.let {
+        Json.decodeFromJsonElement(LongTextShape.serializer(), it).text
+    }
+
+class CalendarPluginAttendeesTest {
+    @Test
+    fun declarationUsesExistingTextShapeAndCalendarPermission() {
+        val declaration = CalendarFixture().plugin.sources.single()
+        assertEquals(listOf(SourceShapeNames.LONG_TEXT), declaration.properties[CalendarPlugin.PROPERTY_ATTENDEES])
+        assertEquals(listOf(PluginPermission(PluginPermissions.CALENDAR)), declaration.callerPermissions)
+    }
+
+    @Test
+    fun namesAndRoomResourcesRemainSeparateLinesWithoutEmails() = runTest {
+        val fixture = CalendarFixture()
+        fixture.event = fixture.event.copy(attendees = listOf(
+            attendee(" Alex Sample ", "alex@example.invalid"), attendee(ROOM),
+            attendee("Jordan\r\nSample"), attendee(null, "private@example.invalid"), attendee("  "),
+        ))
+        val envelope = fixture.envelope()
+        assertEquals("Alex Sample\n$ROOM\nJordan Sample", envelope.instances.single().attendeeText())
+        assertEquals(1, fixture.reads)
+        assertFalse(Json.encodeToString(SourceEnvelope.serializer(), envelope).contains("example.invalid"))
+    }
+
+    @Test
+    fun emptyListIsPresentButSubscribersWithoutAttendeesReceiveNoList() = runTest {
+        val fixture = CalendarFixture()
+        assertEquals("", fixture.envelope().instances.single().attendeeText())
+        fixture.event = fixture.event.copy(attendees = listOf(attendee("Alex Sample")))
+        assertNull(fixture.envelope(listOf(SourceInstance.PROPERTY_NAME)).instances.single().attendeeText())
+        assertEquals("Alex Sample", fixture.envelope(null).instances.single().attendeeText())
+    }
+
+    @Test
+    fun attendeeUpdatesReplaceEarlierNames() = runTest {
+        val fixture = CalendarFixture()
+        fixture.event = fixture.event.copy(attendees = listOf(attendee("Alex Sample"), attendee(ROOM)))
+        assertEquals("Alex Sample\n$ROOM", fixture.envelope().instances.single().attendeeText())
+        fixture.event = fixture.event.copy(attendees = listOf(attendee("Jordan Sample")))
+        assertEquals("Jordan Sample", fixture.envelope().instances.single().attendeeText())
+    }
+
+    @Test
+    fun deniedPermissionAndDisabledCalendarsDoNotReadEvents() = runTest {
+        val fixture = CalendarFixture()
+        fixture.permitted = false
+        assertEquals(emptyList(), fixture.envelope().instances)
+        fixture.permitted = true
+        fixture.calendars = fixture.calendars.map { it.copy(enabled = false) }
+        assertEquals(emptyList(), fixture.envelope().instances)
+        assertEquals(0, fixture.reads)
+    }
+}
